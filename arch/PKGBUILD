# Maintainer: CharOfString <root@charofstring.cc>
pkgname=deepin-daemon-git
pkgver=4.0.16
pkgrel=1
pkgdesc='Daemon handling the GXDE session settings'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/deepin-daemon"
license=('GPL-3.0-or-later')
# 依赖取自 debian/control。cgroup-tools 与 hwinfo 未被代码使用（前者 Arch 没有，后者 aarch64 没有），
# user-setup 是 Debian 安装器专用，因此不列出
# Depends from debian/control.  cgroup-tools and hwinfo are not used by the
# code (the former is missing on Arch, the latter on aarch64) and user-setup
# is Debian installer specific, so they are left out.
depends=('upower' 'networkmanager' 'iso-codes' 'gvfs' 'gnome-keyring' 'gxde-desktop-base-git'
         'gxde-sound-theme-git' 'flakewm-git' 'gxde-desktop-schemas-git' 'mobile-broadband-provider-info'
         'bamf' 'gxde-polkit-agent-git' 'xdotool' 'pam' 'libnl' 'dnsmasq' 'imwheel' 'procps-ng'
         'gxde-shell-tools-git' 'gxde-installer-timezones-git' 'gxde-api-git' 'fprintd'
         'gtk3' 'glib2' 'gdk-pixbuf-xlib' 'fontconfig' 'libinput' 'libx11' 'libxcb' 'libxcursor'
         'libxfixes' 'libxi' 'libxkbfile' 'libxtst' 'systemd-libs' 'libfprint' 'libpulse' 'glibc')
optdepends=('proxychains-ng: application proxy'
            'flatpak: Flatpak application support'
            'iio-sensor-proxy: automatic screen rotation and light sensors'
            'orca: screen reader'
            'bluez: Bluetooth')
makedepends=('git' 'go' 'python' 'librsvg' 'deepin-gettext-tools' 'golang-gxde-dev-git')
provides=('deepin-daemon')
conflicts=('deepin-daemon')
backup=('etc/pam.d/deepin-auth-keyboard')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

# make install 依赖 build 目标，两步使用同样的环境 ・ make install depends on the build target, so both steps share one environment.
_goenv() {
  export CGO_CPPFLAGS="${CPPFLAGS}"
  # go-gir 生成的 C 代码使用无参数原型 f()，在 GCC 默认的 C23 下会冲突
  # The C code generated by go-gir uses empty prototypes f(), which clash
  # under GCC's default C23.
  export CGO_CFLAGS="${CFLAGS} -std=gnu17"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  # 仍是 GOPATH 模式，不能使用 -mod ・ Still GOPATH mode, so no -mod flag.
  export GOFLAGS="-buildmode=pie -trimpath"
  export GO111MODULE=off
  export GOCACHE="$srcdir/gocache"
}

build() {
  _goenv
  make -C "$(_srcroot)"
}

package() {
  _goenv
  # Arch 没有 /lib，PAM 模块在 /usr/lib/security ・ Arch has no /lib, PAM modules live in /usr/lib/security.
  make -C "$(_srcroot)" DESTDIR="$pkgdir" PAM_MODULE_DIR=usr/lib/security install
  install -d "$pkgdir/usr/lib/systemd"
  mv "$pkgdir/lib/systemd/system" "$pkgdir/usr/lib/systemd/"
  rmdir "$pkgdir/lib/systemd" "$pkgdir/lib"
}
